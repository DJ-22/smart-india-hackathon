# Copy to .env and fill in the LiveKit values. Precedence: a real shell env var
# overrides .env, which overrides the defaults baked into common/config.py.
# .env is gitignored; this template is committed. Do not put real secrets here.

# --- LiveKit (required for capture_test.py / livekit_agent.py / tokens.py) ---
LIVEKIT_URL=wss://your-project.livekit.cloud   # your LiveKit Cloud/self-hosted ws URL
LIVEKIT_API_KEY=APIxxxxxxxxxxxx                 # project API key
LIVEKIT_API_SECRET=your-api-secret-here         # project API secret

# --- Server mode ---
STUB_MODE=0            # 0 = real cascade (default), 1 = random-score stub

# --- Cascade thresholds (calibration knobs) ---
T_LOW=0.0              # p0 below this -> discharged as real at L0 (0.0 = discharge off)
T_HIGH=0.9974          # p0 above this -> skip L1, straight to L2
MIN_SPEECH_RATIO=0.30  # windows below this speech fraction are VAD-gated
HYSTERESIS_CLEAN_WINDOWS=10  # consecutive clean windows needed to cool a hot session

# --- UI risk bands (EMA-smoothed score in ui/risk.py; server never smooths) ---
L1_AMBER=0.645         # smoothed score at/above this -> AMBER
L1_RED=0.825           # smoothed score at/above this -> RED

# --- Demo-day escape hatches ---
CASCADE_ENABLED=0      # 0 = flat pipeline: L0 bypassed, L1 always-on (measured default)
L2_ENABLED=1           # 0 = speaker verification fully disabled

# --- Other tunables (rarely changed) ---
EMA_ALPHA=0.35         # for the UI's smoothing only; the server never smooths
WINDOW_S=4.0           # scoring window length, seconds (matches L1 crop_s)
HOP_S=1.0              # window stride, seconds
TARGET_SR=16000        # working sample rate, Hz
CHECKPOINT_MANIFEST=ml/checkpoints/MANIFEST.json  # relative paths resolve to repo root
PORT=8000              # port for `python server/app.py` (uvicorn --port overrides)
